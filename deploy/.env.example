# Two DNS A records pointing to this server. Do not include https://.
APP_DOMAIN=voice.example.com
LIVEKIT_DOMAIN=rtc.example.com
# Set to your modified source repository if you publish a fork.
SOURCE_URL=https://github.com/CukeLabDev/voice

# Replace every value below with a different random secret before deployment.
# LIVEKIT_API_KEY: letters and digits, at least 12 characters.
# LIVEKIT_API_SECRET: at least 32 characters.
POSTGRES_PASSWORD=replace_with_a_random_database_password
JWT_SECRET=replace_with_a_long_random_jwt_secret
LIVEKIT_API_KEY=replace_with_a_random_api_key
LIVEKIT_API_SECRET=replace_with_a_long_random_livekit_secret
